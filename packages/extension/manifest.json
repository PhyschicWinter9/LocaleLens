{
  "manifest_version": 3,
  "name": "LocaleLens",
  "version": "0.6.0",
  "description": "Click text in your dev app to edit its translations in your local project. Personal project, provided as-is; edits your files, so back up first.",
  "minimum_chrome_version": "116",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "LocaleLens" },
  "devtools_page": "devtools.html",
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "http://[::1]/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*", "http://*.localhost/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
