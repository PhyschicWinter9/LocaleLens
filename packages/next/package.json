{
  "name": "@localelens/next",
  "version": "0.5.1",
  "type": "module",
  "main": "dist/index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./dist/index.js"
    },
    "./loader": "./dist/loader.cjs"
  },
  "files": [
    "dist",
    "index.d.ts"
  ],
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@localelens/core": "workspace:*",
    "@localelens/ast-engine": "workspace:*"
  },
  "license": "GPL-3.0-only",
  "description": "Dev-only Next.js (Turbopack + webpack) integration for LocaleLens: tags JSX text with source references. No effect on production builds.",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "i18n",
    "localization",
    "translations",
    "react",
    "nextjs",
    "vite",
    "devtools",
    "react-i18next",
    "next-intl"
  ],
  "engines": {
    "node": ">=22.18"
  }
}
