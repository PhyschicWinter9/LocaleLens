{
  "name": "localelens-monorepo",
  "private": true,
  "version": "0.6.0",
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "node scripts/build-packages.mjs && node packages/extension/build.mjs",
    "verify": "bun run typecheck && bun run test && bun run build",
    "demo": "node scripts/demo.mjs",
    "version-packages": "changeset version && node scripts/sync-versions.mjs && bun install --lockfile-only",
    "release:check": "node scripts/release-check.mjs",
    "release:artifacts": "node scripts/release-artifacts.mjs",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@babel/parser": "^8.0.8",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.8",
    "@changesets/cli": "^3.0.3",
    "@localelens/next": "workspace:*",
    "@localelens/vite": "workspace:*",
    "@playwright/test": "^1.64.1",
    "@types/babel__traverse": "^7.28.0",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "latest",
    "esbuild": "^0.28.2",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "i18next": "^26.5.11",
    "jsonc-parser": "^3.3.1",
    "magic-string": "^1.4.5",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "preact": "^11.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.9",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "license": "GPL-3.0-only"
}
