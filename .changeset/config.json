{
  "$schema": "https://unpkg.com/@changesets/config@3.0.0/schema.json",
  "changelog": "@changesets/cli/changelog",
  "commit": false,
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "ignore": [
    "playground-vite",
    "playground-next-app",
    "playground-next-pages",
    "localelens-monorepo",
    "@localelens/core",
    "@localelens/ast-engine",
    "@localelens/file-writer",
    "@localelens/locale-registry",
    "@localelens/adapter-i18next",
    "@localelens/adapter-next-intl",
    "@localelens/dev-agent",
    "@localelens/translation-excel",
    "@localelens/extension"
  ],
  "fixed": [
    [
      "@localelens/cli",
      "@localelens/vite",
      "@localelens/next"
    ]
  ],
  "privatePackages": {
    "version": false,
    "tag": false
  }
}
